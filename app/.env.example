APP_NAME=Intraclub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_BE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB en niet sqlite: de importcommandos lezen uit de connecties `legacy` en
# `archive`, en die staan in config/database.php hard op de mariadb-driver.
# De testsuite negeert dit blok - phpunit.xml forceert sqlite :memory:.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=intraclub
DB_USERNAME=root
DB_PASSWORD=

# Alleen nodig voor de datamigratie (zie PLAN.md, fase 6). Zonder deze regels
# gebruikt config/database.php root met een leeg wachtwoord; heb je wel een
# root-wachtwoord, dan faalt `intraclub:import-legacy` met een auth-fout.
# LEGACY_DB_DATABASE=intraclub_legacy
# LEGACY_DB_USERNAME=root
# LEGACY_DB_PASSWORD=
# ARCHIVE_DB_DATABASE=intraclub_oud
# ARCHIVE_DB_USERNAME=root
# ARCHIVE_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Origins die de publieke API mogen aanspreken (komma-gescheiden)
CORS_ALLOWED_ORIGINS="https://www.bclandegem.be,https://bclandegem.be,https://bc-landegem.github.io"

# Contactformulier van de clubwebsite (config/contact.php).
# Verstuur via de mailbox van de club zelf: dan slaagt SPF vanzelf en staat DKIM
# er al. Zet de bezoeker nooit als afzender — dat is mail namens gmail.com.
CONTACT_TO=info@bclandegem.be
# Origins waar de bezoeker na het versturen naartoe mag; de eerste is de terugval.
CONTACT_RETURN_ORIGINS="https://bclandegem.be,https://bc-landegem.github.io,http://localhost:4321"
# Leeg = Turnstile overgeslagen. Aanzetten gebeurt samen met de repository
# variable TURNSTILE_SITE_KEY bij de site; één van de twee alleen is ofwel een
# onbeschermd formulier, ofwel een formulier dat elke inzending afwijst.
TURNSTILE_SECRET=
