# Sjabloon voor de .env op de shared hosting. Zet dit bestand één keer met FTP
# in de app-map (naast artisan) als `.env` en vul aan. De deploy-workflow raakt
# .env nooit aan — het staat in de exclude-lijst.

APP_NAME=Intraclub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://intra.bclandegem.be
APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_BE

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=525600
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=intra.bclandegem.be

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Mail (contactformulier van de clubwebsite) -------------------------------
# Versturen via de mailbox van de club zelf: dan slaagt SPF vanzelf en staat DKIM
# er al. Gegevens staan in DirectAdmin bij het e-mailaccount.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=info@bclandegem.be
MAIL_PASSWORD=
# Leeg laten op poort 587: STARTTLS wordt dan zelf onderhandeld.
# Enkel op poort 465 (impliciete TLS) hoort hier smtps te staan.
MAIL_SCHEME=
MAIL_FROM_ADDRESS=info@bclandegem.be
MAIL_FROM_NAME="BC Landegem website"

# Welke origins de publieke API mogen aanspreken (de Joomla-site).
CORS_ALLOWED_ORIGINS=https://www.bclandegem.be,https://bclandegem.be

# In hoeveel recentste berekende speeldagen een speler minstens één match moet
# spelen om nog als actief te gelden. 0 = regel uit. Bijstellen kan zonder deploy
# van de code: waarde aanpassen en de taak `optimize` draaien (zie DEPLOY.md).
RANKING_ACTIVE_ROUNDS=3

# --- Deploy-endpoints (zie config/deploy.php) ---------------------------------
# Zelfde waarde als het GitHub-secret DEPLOY_TOKEN. Leeg = de endpoints bestaan
# niet, en dan kan de workflow geen migrations draaien.
DEPLOY_TOKEN=

# Reset-knop. Zet op false bij de cutover en verwijder daarna de snapshot uit
# storage/app/private/. Let op: na `optimize` zit deze waarde in de cache — een
# wijziging vraagt een nieuwe deploy of de taak 'optimize'.
INTRACLUB_ALLOW_RESET=true
INTRACLUB_SNAPSHOT=app/private/cutover.sql.gz
INTRACLUB_BACKUP_SETS=2

# --- Contactformulier (zie config/contact.php) --------------------------------
# Postbus waar de berichten aankomen.
CONTACT_TO=info@bclandegem.be

# Domeinen waar de bezoeker na het versturen naartoe teruggestuurd mag worden.
# Dit is de enige rem op een open redirect: wat hier niet staat, valt terug op de
# eerste origin uit de lijst. github.io mag eruit zodra de site op het eigen
# domein staat.
CONTACT_RETURN_ORIGINS=https://bclandegem.be,https://www.bclandegem.be,https://bc-landegem.github.io

# Cloudflare Turnstile. Leeg = verificatie overgeslagen, zodat het formulier live
# kan vóór het Cloudflare-account bestaat. Aanzetten is twee variabelen tegelijk:
# deze, en de repository variable TURNSTILE_SITE_KEY bij de site. Zet je er maar
# één, dan is het formulier ofwel onbeschermd, ofwel wijst het alles af.
TURNSTILE_SECRET=

# --- Meldformulier (zie config/melding.php) -----------------------------------
# Postbus van het Aanspreekpunt Integriteit. Dit adres staat nergens op de site;
# het formulier is de enige schriftelijke weg. Het mag dus ook geen alias zijn
# die bij het bestuur uitkomt.
#
# Geen standaardwaarde in de code: blijft dit leeg, dan weigert het formulier
# zichtbaar (?error=unavailable) en bezorgt het niets verkeerd. Wisselt de
# persoon, dan verandert dit adres mee — zie de checklist in DEPLOY.md, want een
# vergeten wijziging levert een formulier op dat blijft werken en bij de vorige
# aanspreekpersoon aflevert.
MELDING_TO=

# --- Pushberichten (zie config/push.php en README "Pushberichten") -------------
# Genereer lokaal met `php artisan push:vapid` en plak beide. Leeg = push staat
# uit: abonnementen worden wel aangenomen, er vertrekt niets, en het paneel zegt
# dat. De publieke helft komt ook als repository variable VAPID_PUBLIC_KEY in de
# Website-repo. Dit paar bewaren: een nieuw paar maakt elk abonnement waardeloos.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@bclandegem.be
# Waar de links in een bericht naartoe wijzen. Tot de domeinswitch is dat de
# github.io-site mét haar base-path (https://bc-landegem.github.io/Website);
# daarna www.bclandegem.be. Zonder slash op het einde.
PUSH_SITE_URL=https://www.bclandegem.be
# De wachtrij leegt via een cron die elke minuut `schedule:run` draait — zie
# DEPLOY.md "Cron". Zonder die cron vertrekt geen enkel bericht.
