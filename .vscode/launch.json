{
    // Xdebug op poort 9003 (zie xdebug.client_port in php.ini).
    // "Listen for Xdebug" is de gewone manier van werken: start hem, draai
    // daarnaast `php artisan serve` in app/, en zet een breakpoint.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Listen for Xdebug",
            "type": "php",
            "request": "launch",
            "port": 9003,
            "pathMappings": {
                "${workspaceFolder}/app": "${workspaceFolder}/app"
            }
        },
        {
            // Start de dev-server zelf en hangt de debugger er meteen aan.
            // Document root is app/public — niet de repo-root, zoals in de
            // oude opzet voor de PHP 7.4-api.
            "name": "artisan serve + debug",
            "type": "php",
            "request": "launch",
            "program": "${workspaceFolder}/app/artisan",
            "args": ["serve"],
            "cwd": "${workspaceFolder}/app",
            "port": 9003
        },
        {
            // Voor een artisan-commando of los script, bv. een importstap.
            "name": "Debug current script in console",
            "type": "php",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "externalConsole": false,
            "port": 9003
        }
    ]
}
