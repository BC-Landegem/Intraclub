parameters:
    level: 5
    paths:
        - src
    ignoreErrors:
        # Monolog 2 PHPStan stubs type the $level argument as a literal union of
        # level constants; passing a plain int is valid at runtime.
        -
            message: '#Parameter \#\d+ \$level of class Monolog\\Handler\\.* constructor expects .*, int given\.#'
            path: src/Factory/LoggerFactory.php
